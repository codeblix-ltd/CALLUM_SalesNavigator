{
   "action": {
      "default_title": "TotLeads"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ 
      "config/config.js", 
      "services/storage-service.js", 
      "services/credential-service.js", 
      "services/quota-service.js", 
      "utils/i18n.js", 
      "utils/api-client.js", 
      "utils/accessibility.js", 
      "utils/messaging.js", 
      "utils/event-detectors.js", 
      "utils/draggable.js", 
      "utils/linkedin-parser.js", 
      "utils/csv-generator.js", 
      "utils/dom-helpers.js", 
      "utils/url-codec.js",
      "data/facets.js",
      "modules/api-data-manager.js", 
      "modules/pagination-manager.js", 
      "modules/url-splitter-engine.js",
      "modules/ui-injector.js", 
      "modules/list-automation.js", 
      "modules/list-injector.js", 
      "modules/onboarding-flow.js", 
      "modules/onboarding-overlay.js", 
      "content-script.js", 
      "floating-window.js", 
      "list-floating-window.js",
      "splitter-floating-window.js",
      "bulk-floating-window.js"
   ],
      "matches": [ "*://*.linkedin.com/*" ],
      "run_at": "document_start"
   } ],
   "description": "Export public leads from professional networks to CSV for free. No cookies used.",
   "externally_connectable": {
      "matches": [ "*://app.totleads.com/*" ]
   },
   "icons": {
      "128": "totleadsicon.png",
      "16": "totleadsicon.png",
      "48": "totleadsicon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "TotLeads",
   "permissions": [ "activeTab", "storage", "scripting" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.10",
   "web_accessible_resources": [ {
      "matches": [ "*://*.linkedin.com/*" ],
      "resources": [ "inject.js", "locales/*.json" ]
   } ]
}
