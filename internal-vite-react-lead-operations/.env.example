# Convex CLI writes these after the project is linked.
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Server-only. Never prefix these values with VITE_.
COCKROACH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=use-a-long-unique-password

# GHL is configured on the Convex deployment with `pnpm exec convex env set`.
# Keep the private-integration token out of this file and out of git.
GHL_LOCATION_ID=your-ghl-sub-account-location-id
GHL_LINKEDIN_CUSTOM_FIELD_ID=your-linkedin-profile-contact-field-id
