{
  "manifest_version": 3,
  "name": "Callum Leads",
  "description": "Secure scout queues, lead status tracking, drafting, and an isolated mock LinkedIn simulator.",
  "version": "0.3.0",
  "action": {
    "default_title": "Callum Leads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["alarms", "clipboardWrite", "storage", "tabs"],
  "host_permissions": [
    "https://*.convex.cloud/*",
    "https://*.convex.site/*"
  ]
}
