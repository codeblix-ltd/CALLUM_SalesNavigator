{
  "manifest_version": 3,
  "name": "Callum Leads",
  "description": "Automated LinkedIn lead engagement, post commenting, and connection requests.",
  "version": "0.7.3",
  "action": {
    "default_title": "Callum Leads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://*.convex.cloud/*",
    "https://*.convex.site/*",
    "https://*.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": ["config.js", "convex-client.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
