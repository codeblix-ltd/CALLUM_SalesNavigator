# Copy this file to .env.gateway on the VPS. Use the generated values from
# your local .env.local; do not generate a second shared secret or encryption key.
PORT=8787
HOST=0.0.0.0
CODEX_HOME=/var/lib/callum-codex
CODEX_MODEL=gpt-5.6-luna
CODEX_GATEWAY_SHARED_SECRET=copy-from-local-env
# Separate scoped token used by trusted browser extensions. Do not reuse the
# admin shared secret in extension source or browser storage.
CODEX_GATEWAY_EXTENSION_TOKEN=generate-a-long-random-token
# Separate server-side token used only by the Veblen admin matching pilot.
CODEX_GATEWAY_VEBLEN_TOKEN=generate-a-different-long-random-token
# Optional comma-separated HTTPS origins for future web apps. Chrome extension
# origins are supported automatically and still require the extension token.
CODEX_GATEWAY_ALLOWED_ORIGINS=
CODEX_AUTH_ENCRYPTION_KEY=copy-from-local-env
COCKROACH_DATABASE_URL=copy-from-local-env
