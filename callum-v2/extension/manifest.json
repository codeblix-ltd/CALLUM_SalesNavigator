{
  "manifest_version": 3,
  "name": "Callum Scout V2",
  "description": "Canary browser adapter for the isolated Callum V2 control plane.",
  "version": "2.5.1",
  "action": { "default_title": "Callum Scout V2", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "http://localhost:8788/*",
    "https://api-v2.careeraccelerator.net/*"
  ],
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
    "js": ["config.js", "adapter.js", "content.js"],
    "run_at": "document_idle"
  }]
}
